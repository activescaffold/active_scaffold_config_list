<% selector_class = "config-list-views #{active_scaffold_config.config_list.named_views_position}" %>
<% if active_scaffold_config.config_list.named_views_selector == :links %>
  <%= as_element :config_list_views, class: selector_class do %>
    <%= active_scaffold_named_view_selector %>
  <% end %>
<% else %>
  <% attributes = as_element_attributes(:config_list_views_form, class: selector_class, remote: true, method: :get) %>
  <%= form_tag params_for(action: :index, config_list_view: nil), attributes do %>
    <%= active_scaffold_named_view_selector %>
  <% end %>
<% end %>
