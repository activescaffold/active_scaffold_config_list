<% url_options = params_for(action: :config_list) -%>
<%= render partial: 'base_form', locals: {form_action: :config_list,
                                          method: :post,
                                          url_options: url_options,
                                          body_partial: 'show_config_list_form_body',
                                          multipart: false,
                                          persistent: false,
                                          field_descriptions: :show,
                                          cancel_link: true,
                                          cancel_text: params[:config_list_view].present? ? :delete : :reset,
                                          cancel_attrs: {data: {refresh: true, method: :post}},
                                          cancel_url: url_for(url_options.merge(config_list: '')),
                                          headline: active_scaffold_config.config_list.label} %>

