<%= as_element :fields_container, class: 'form' do %>
  <% if config_list_columns? %>
    <%= as_element :form_element, class: 'form-element' do %>
      <%
        columns_options = as_element_attributes(
          :config_list_columns,
          name: 'config_list',
          id: "#{element_form_id(action: :config_list)}-columns",
          class: ('sortable-container' unless active_scaffold_config.config_list.draggable)
        ).to_h
        content = active_scaffold_checkbox_list(
          nil,
          config_list_columns,
          config_list_params || config_list_columns.map(&:last),
          columns_options,
          ui_options: {
            draggable_lists: active_scaffold_config.config_list.draggable,
            item_options: as_element_attributes(:config_list_column, class: 'sortable').to_h
          }
        )
      %>
      <%= form_attribute_html(nil, as_(:columns), content, nil, {}) %>
    <% end %>
  <% end %>

  <% if config_list_sorting? %>
    <%= as_element :form_element, class: 'form-element' do %>
      <% content = capture do %>
        <%= as_element :config_list_sorting do %>
          <%
            columns_options = list_columns.select(&:sortable?).map { |c| [c.label, c.name] }
            order_options = ['asc', 'desc'].map { |v| [as_(v), v] }
            selected = config_list_sorting || []
            3.times do |i|
          %>
            <%= as_element :config_list_sorting_item do %>
              <%= select_tag "config_list_sorting[#{i}][]", options_for_select(columns_options, selected: selected[i]&.first), as_element_attributes(:config_list_sorting_column, include_blank: as_(:_select_), class: 'column') %>
              <%= select_tag "config_list_sorting[#{i}][]", options_for_select(order_options, selected: selected[i]&.last), as_element_attributes(:config_list_sorting_order, include_blank: as_(:_select_), class: 'order') %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= form_attribute_html(nil, as_(:default_sorting), content, nil, {}) %>
    <% end %>
  <% end %>

  <% if config_list_save_named_views? %>
    <%= as_element :form_element, class: 'form-element' do %>
      <% content = capture do %>
        <% name_options = active_scaffold_input_text_options(required: @config_list_view_name.present?) %>
        <%= text_field_tag "config_list_view_name", @config_list_view_name.to_s, as_element_attributes(:config_list_view_name, **name_options) %>
        <% if @config_list_view_name.present? %>
          <%= as_element :config_list_view_rename, class: 'rename-view', style: 'display: none;' do %>
            <%= check_box_tag 'config_list_old_view_name', params[:config_list_view], false, **as_element_attributes(:config_list_view_rename_checkbox, id: nil).to_h %>
            <%= as_ :rename_view, view_name: @config_list_view_name %>
          <% end %>
        <% end %>
        <% if config_list_global_views? %>
          <%= as_element :config_list_view_global, class: 'global-view', style: ('display: none;' if @config_list_view_name.blank?) do %>
            <%= hidden_field_tag 'global_view', @global_view ? '1' : '' %>
            <%= check_box_tag 'global_view', '1', @global_view, **as_element_attributes(:config_list_view_global_checkbox, id: nil, disabled: true).to_h %>
            <%= as_ :global_view %>
          <% end %>
        <% end %>
      <% end %>
      <%= form_attribute_html(nil, as_(:view_name), content, nil, {}) %>
    <% end %>
  <% end %>
<% end %>
